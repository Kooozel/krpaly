# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.ruff_cache/
.pytest_cache/

# Node
node_modules/
dist/
.svelte-kit/
build/

# Derivation inputs and intermediates — large, reproducible, never committed
# Manifests are committed under derive/manifests/, not re-included here: git cannot
# re-include a file under an excluded directory, and the copy in data/ carries `run`.
data/
*.pbf
*.tif
*.tiff
*.laz

# ...except the extraction fixture, which is a few kilobytes and has to be
# committed: a test suite with no committed input tests nothing. The blanket
# rule above excludes files and never a parent directory, so this negation
# takes effect.
!derive/tests/fixtures/*.pbf

# Secrets and local config
.env
.env.*
!.env.example

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/*
!.vscode/extensions.json
*.sw?

# Claude Code workspace (local, per-developer)
.claude/
